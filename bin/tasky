#!/usr/bin/env python3
"""Tasky CLI entry point.

A Python script rather than a `python3 -m tasky` shim: `-m` puts the caller's
current working directory first on `sys.path`, ahead of anything this script
could insert, so a cwd that happens to ship its own `tasky/` package would
shadow this one and run as the caller's user (CWE-427). Resolving through the
symlink and inserting that real directory here closes that gap and works the
same way whether this file is run directly or through a symlink elsewhere.
"""

import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, _ROOT)

from tasky.cli import main  # noqa: E402

sys.exit(main())
